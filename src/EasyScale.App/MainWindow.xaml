<ui:FluentWindow x:Class="EasyScale.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                                  xmlns:loc="clr-namespace:EasyScale.App.Localization"
                 xmlns:vm="clr-namespace:EasyScale.App.ViewModels"
                 xmlns:tray="clr-namespace:Wpf.Ui.Tray.Controls;assembly=Wpf.Ui.Tray"
                 mc:Ignorable="d"
                                  Title="{loc:Tr Main_Title}"
                 Icon="pack://application:,,,/Assets/easy-scale.ico"
                 Width="460" Height="420"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 托盘图标：左键唤起主窗口，右键弹出菜单（菜单项在代码后置中按语言/预设动态构建）。 -->
        <tray:NotifyIcon x:Name="TrayIcon"
                         Grid.Row="0"
                         Icon="pack://application:,,,/Assets/easy-scale.ico"
                         TooltipText="{loc:Tr Tray_Tooltip}"
                         FocusOnLeftClick="True"
                         MenuOnRightClick="True" />

        <ui:TitleBar Grid.Row="0" Title="{loc:Tr Main_Title}" />

        <!-- 显示器列表：每项展示友好名与档位选择 -->
        <ScrollViewer Grid.Row="1" Padding="16,8" VerticalScrollBarVisibility="Auto">
            <Grid>
                <ItemsControl ItemsSource="{Binding Monitors}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:MonitorItemViewModel}">
                            <ui:Card Margin="0,0,0,12" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="{Binding FriendlyName}"
                                               FontSize="16" FontWeight="SemiBold"
                                               Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding DevicePath}"
                                               FontSize="11" Opacity="0.6"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,10" />
                                    <ComboBox ItemsSource="{Binding Options}"
                                              SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Percent, StringFormat={}{0}%}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{loc:Tr Main_NoMonitors}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Opacity="0.6">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMonitors}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="16">
            <ui:Button Content="{loc:Tr Tray_Settings}"
                       Icon="{ui:SymbolIcon Settings24}"
                       Click="OnSettingsClick"
                       Margin="0,0,8,0" />
            <ui:Button Content="{loc:Tr Main_Refresh}"
                       Icon="{ui:SymbolIcon ArrowSync24}"
                       Command="{Binding RefreshCommand}" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
