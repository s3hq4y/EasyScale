<ui:FluentWindow x:Class="EasyScale.App.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:EasyScale.App.Localization"
                 xmlns:vm="clr-namespace:EasyScale.App.ViewModels"
                 mc:Ignorable="d"
                                  Title="{loc:Tr Settings_Title}"
                 Icon="pack://application:,,,/Assets/easy-scale.ico"
                 Width="520" Height="600"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{loc:Tr Settings_Title}" />

        <ScrollViewer Grid.Row="1" Padding="20" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 语言 -->
                <TextBlock Text="{loc:Tr Settings_Language}" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ComboBox ItemsSource="{Binding Languages}"
                          SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" Margin="0,0,0,16">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SettingsViewModel+LanguageOption}">
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- 主题 -->
                                <TextBlock Text="{loc:Tr Settings_Theme}" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ComboBox ItemsSource="{Binding Themes}"
                          SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" Margin="0,0,0,16">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SettingsViewModel+ThemeOption}">
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- 开机自启 -->
                <ui:ToggleSwitch Content="{loc:Tr Settings_AutoStart}"
                                 IsChecked="{Binding AutoStartEnabled, Mode=TwoWay}"
                                 Margin="0,0,0,20" />

                <Separator Margin="0,0,0,16" />

                <!-- 预设管理 -->
                <TextBlock Text="{loc:Tr Settings_Presets}" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ListView ItemsSource="{Binding Presets}"
                          SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                          MinHeight="140" Margin="0,0,0,10">
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:ScalePreset}"
                                      xmlns:models="clr-namespace:EasyScale.App.Models">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding Rel, StringFormat=rel {0}}" Opacity="0.6" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Grid.Column="0"
                                PlaceholderText="{loc:Tr Settings_PresetName}"
                                Text="{Binding NewPresetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,0,8,0" />
                    <ui:Button Grid.Column="1"
                               Content="{loc:Tr Settings_AddPreset}"
                               Icon="{ui:SymbolIcon Add24}"
                               Command="{Binding AddPresetCommand}" />
                </Grid>

                <ui:Button Content="{loc:Tr Settings_DeletePreset}"
                           Icon="{ui:SymbolIcon Delete24}"
                           Command="{Binding DeletePresetCommand}"
                           HorizontalAlignment="Left" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>