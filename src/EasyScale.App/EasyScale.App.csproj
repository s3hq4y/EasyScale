<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
        <RootNamespace>EasyScale.App</RootNamespace>
        <AssemblyName>EasyScale</AssemblyName>
        <!-- 嵌入 exe 的应用图标（任务栏/资源管理器显示）。 -->
        <ApplicationIcon>Assets\easy-scale.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- 单文件绿色版发布：
       dotnet publish src/EasyScale.App -c Release -r win-x64 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WPF 依赖的原生库随单文件打包，不额外落地 -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- 绿色版不需要调试符号与多余文件 -->
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Fluent 2 风格的 WPF 控件库（含托盘支持） -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="WPF-UI.Tray" Version="4.3.0" />
  </ItemGroup>

    <ItemGroup>
    <ProjectReference Include="..\EasyScale.Core\EasyScale.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 托盘与应用图标，作为 WPF 资源打包（pack://application:,,,/Assets/easy-scale.ico） -->
    <Resource Include="Assets\easy-scale.ico" />
  </ItemGroup>

</Project>
